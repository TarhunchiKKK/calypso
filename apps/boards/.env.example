NODE_ENV=dev

BOARDS_GRPC_URL=boards-service:50051
BOARD_NODES_GRPC_URL=boards-service:50052

# Postgres
SQL_DB_NAME=boards
SQL_DB_HOST=boards-sql-db
SQL_DB_PORT=5432
SQL_DB_USER=root
SQL_DB_PASS=123456

# MongoDB
NOSQL_DB_NAME=nodes
NOSQL_DB_HOST=boards-nosql-db
NOSQL_DB_PORT=27012

# Redis
REDIS_HOST=boards-cache
REDIS_PORT=6379
REDIS_DEFAULT_TTL=600

# RabbitMQ
RMQ_QUEUE=boards

