{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": { 
    "dev": "bun run --bun nest start --watch",
    "build": "bun run --bun nest build",
    "start": "bun run --bun nest start",
    "start:debug": "bun run --bun nest start --debug --watch",
    "start:prod": "bun run --bun node dist/main",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@repo/api": "*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.5.4"
  }
