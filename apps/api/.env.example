NODE_ENV=dev

APP_URL=http://localhost:3000
APP_PORT=3000

# Cookie
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_EXPIRATION=1d
REFRESH_COOKIE_EXPIRATION=10d

# JWT
JWT_SECRET=sHLDeuhfnjgrmdzhpxrajdsrmuehfnrt
ACCESS_JWT_EXPIRATION=1d
REFRESH_JWT_EXPIRATION=10d

# Swagger
SWAGGER_PATH=/docs
SWAGGER_TITLE=Gateway
SWAGGER_DESCRIPTION=Gateway Service
SWAGGER_VERSION=1.0.0

# Postgres
SQL_DB_NAME=gateway
SQL_DB_HOST=gateway-slq-db
SQL_DB_PORT=5431
SQL_DB_USER=root
SQL_DB_PASS=123456


# MongoDB
NOSQL_DB_NAME=nodes
NOSQL_DB_HOST=boards-nosql-db
NOSQL_DB_PORT=27012


# Redis
REDIS_HOST=gateway-cache
REDIS_PORT=6379
REDIS_DEFAULT_TTL=600


# Mailer
MAIL_HOST=
MAIL_PORT=
MAIL_LOGIN=
MAIL_PASSWORD=
MAIL_FROM="admin@gmail.com"
MAIL_KEY=


# S3
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=calypso
S3_REGION=us-east-1
S3_PORT=9000
S3_UI_PORT=9001


# Logging
APP_LABEL=gateway
LOKIURL=loki-url


# Presets
ASSETS_DIRECTORY=assets


# Web
WEB_URL=http://localhost:5173

