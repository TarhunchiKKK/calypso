        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.11",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/mapped-types": "*",
        "@nestjs/microservices": "^11.1.19",
        "@nestjs/platform-express": "^11.1.11",
        "@react-email/components": "^1.0.12",
        "@react-email/html": "^0.0.12",
        "amqp-connection-manager": "^5.0.0",
