NODE_ENV=dev

APP_URL=http://localhost:3000
APP_PORT=3000

# Cookie
COOKIE_HTTP_ONLY=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_EXPIRATION=1d
REFRESH_COOKIE_EXPIRATION=10d

# JWT
JWT_SECRET=sHLDeuhfnjgrmdzhpxrajdsrmuehfnrt
ACCESS_JWT_EXPIRATION=1d
REFRESH_JWT_EXPIRATION=10d

# Swagger
SWAGGER_PATH=/docs
SWAGGER_TITLE=Gateway
SWAGGER_DESCRIPTION=Gateway Service
SWAGGER_VERSION=1.0.0

# Postgres
SQL_DB_NAME=gateway
SQL_DB_HOST=gateway-slq-db
SQL_DB_PORT=5431
SQL_DB_USER=root
SQL_DB_PASS=123456

# Redis
REDIS_HOST=gateway-cache
REDIS_PORT=6379
REDIS_DEFAULT_TTL=600

# RabbitMQ
BOARDS_SERVICE_RMQ_QUEUE=boards
MAILS_WORKER_RMQ_QUEUE=mails

# Services

## Boards Service
BOARDS_SERVICE_GRPC_URL=boards-service:50051
