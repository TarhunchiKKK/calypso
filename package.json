{
    "name": "calypso",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Virtual whiteboard tool that lets you easily sketch diagrams that have a hand-drawn feel to them.",
    "license": "MIT",
    "author": {
        "name": "Konstantin Barilo",
        "email": "kostabarilo12@gmail.com",
        "url": "https://github.com/TarhunchiKKK"
    },
    "scripts": {
        "dev": "turbo run dev",
        "dev:gateway": "turbo run dev --filter=gateway",
        "dev:boards": "turbo run dev --filter=boards",
        "dev:web": "turbo run dev --filter=web",
        "build": "turbo run build",
        "build:gateway": "turbo run build --filter=gateway",
        "build:boards": "turbo run build --filter=boards",
        "build:web": "turbo run build --filter=web",
        "build:packages": "turbo run build --filter=@repo/common --filter=@repo/boards-common --filter=@repo/api",
        "build:api": "turbo run build --filter=@repo/api",
        "build:common": "turbo run build --filter=@repo/common",
        "build:boards-common": "turbo run build --filter=@repo/boards-common",
        "type-check": "turbo run type-check",
        "type-check:gateway": "turbo run type-check --filter=gateway",
        "type-check:boards": "turbo run type-check --filter=boards",
        "type-check:web": "turbo run type-check --filter=web",
        "type-check:api": "turbo run type-check --filter=@repo/api",
        "type-check:common": "turbo run type-check --filter=@repo/common",
        "type-check:boards-common": "turbo run type-check --filter=@repo/boards-common",
        "test:unit": "turbo run test:unit",
        "test:unit:web": "turbo run test:unit --filter=web",
        "test:e2e": "turbo run test:e2e",
        "test:e2e:web": "turbo run test:e2e --filter=web",
        "format:check": "bunx biome format",
        "format:fix": "bunx biome format --write",
        "lint:check": "bunx --bun biome lint",
        "lint:fix": "bunx --bun biome lint --write",
        "knip": "knip",
        "env:load": "bun run scripts/load-env.ts",
        "env:refresh-example": "bun run scripts/refresh-env-example.ts",
        "docker:infra": "docker compose -f docker/infra.yaml --env-file .env up -d",
        "docker:gateway": "docker compose -f docker/infra.yaml -f docker/gateway.yaml --env-file .env up -d",
        "docker:boards": "docker compose -f docker/infra.yaml -f docker/boards.yaml --env-file .env up -d",
        "docker:web": "docker compose -f docker/web.yaml --env-file .env up",
        "docker:down": "docker compose -f docker/infra.yaml -f docker/gateway.yaml -f docker/boards.yaml -f docker/web.yaml down"
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@repo/typescript-config": "*",
        "turbo": "^2.8.17"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "bun@1.3.4",
    "workspaces": ["apps/*", "packages/*"],
    "dependencies": {
        "@biomejs/biome": "^2.4.7",
        "knip": "^5.86.0"
    }
}
