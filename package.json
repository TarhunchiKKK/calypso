{
    "name": "calypso",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "Virtual whiteboard tool that lets you easily sketch diagrams that have a hand-drawn feel to them.",
    "license": "MIT",
    "author": {
        "name": "Konstantin Barilo",
        "email": "kostabarilo12@gmail.com",
        "url": "https://github.com/TarhunchiKKK"
    },
    "scripts": {
        "dev": "turbo run dev",
        "dev:api": "turbo run dev --filter=api",
        "dev:web": "turbo run dev --filter=web",
        "build": "turbo run build",
        "build:api": "turbo run build --filter=api",
        "build:web": "turbo run build --filter=web",
        "build:common": "turbo run build --filter=@repo/common",
        "type-check": "turbo run type-check",
        "type-check:api": "turbo run type-check --filter=api",
        "type-check:web": "turbo run type-check --filter=web",
        "test:unit": "turbo run test:unit",
        "test:unit:api": "turbo run test:unit --filter=api",
        "test:unit:web": "turbo run test:unit --filter=web",
        "test:e2e": "turbo run test:e2e",
        "test:e2e:api": "turbo run test:e2e --filter=api",
        "test:e2e:web": "turbo run test:e2e --filter=web",
        "format:check": "bunx biome format",
        "format:fix": "bunx biome format --write",
        "lint:check": "bunx --bun biome lint",
        "lint:fix": "bunx --bun biome lint --write",
        "knip": "knip",
        "env:refresh-example": "bun run scripts/refresh-env-example.ts"
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@repo/typescript-config": "*",
        "turbo": "^2.8.17"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "bun@1.3.4",
    "workspaces": ["apps/*", "packages/*"],
    "dependencies": {
        "@biomejs/biome": "^2.4.7",
        "knip": "^5.86.0"
    }
}
