{
    "name": "calypso",
    "version": "0.0.0",
    "author": {
        "name": "Konstantin Barilo",
        "email": "kostabarilo12@gmail.com",
        "url": "https://github.com/TarhunchiKKK"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.7",
        "knip": "^5.86.0",
        "turbo": "^2.8.17"
    },
    "description": "Virtual whiteboard tool that lets you easily sketch diagrams that have a hand-drawn feel to them.",
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "packageManager": "bun@1.3.4",
    "private": true,
    "scripts": {
        "dev": "turbo run dev --filter=gateway --filter=boards --filter=web ",
        "seed:media": "turbo run seed --filter=media",
        "build": "turbo run build",
        "build:packages": "turbo run build --filter=@repo/common --filter=@repo/boards-common --filter=@repo/api",
        "type-check": "turbo run type-check",
        "type-check:packages": "turbo run type-check --filter=@repo/common",
        "test:unit": "turbo run test:unit",
        "test:unit:web": "turbo run test:unit --filter=web",
        "format:check": "bunx biome format",
        "format:fix": "bunx biome format --write",
        "lint:check": "bunx --bun biome lint",
        "lint:fix": "bunx --bun biome lint --write",
        "knip": "knip",
        "env:load": "bun run scripts/load-env.script.ts",
        "env:refresh-example": "bun run scripts/refresh-env-example.script.ts",
        "docker:up": "docker compose -f docker/infra.yaml -f docker/gateway.yaml -f docker/boards.yaml -f docker/media.yaml --env-file .env up",
        "docker:down": "docker compose -f docker/infra.yaml -f docker/gateway.yaml -f docker/boards.yaml -f docker/media.yaml down",
        "dev:current": "turbo run dev --filter=web",
        "build:current": "turbo run build --filter=web"
    },
    "type": "module",
    "workspaces": ["apps/*", "packages/*"]
}
