        "clsx": "^2.1.1",
        "lucide-react": "^0.556.0",
        "next": "16.0.7",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "slate": "^0.123.0",
        "slate-history": "^0.113.1",
        "slate-react": "^0.123.0",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.11",
