{
    "name": "calypso",
    "version": "0.0.0",
    "author": {
        "name": "Konstantin Barilo",
        "email": "kostabarilo12@gmail.com",
        "url": "https://github.com/TarhunchiKKK"
    },
    "description": "Virtual whiteboard tool that lets you easily sketch diagrams that have a hand-drawn feel to them.",
    "license": "MIT",
    "type": "module",
    "packageManager": "bun@1.3.4",
    "private": true,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "turbo run dev --filter=gateway --filter=boards",
        "seed:media": "turbo run seed --filter=media",
        "build": "turbo run build",
        "build:packages": "turbo run build --filter=@config/* --filter=@api/* --filter=@lib/* --filter=@contracts/*",
        "type-check": "turbo run type-check",
        "type-check:packages": "turbo run type-check --filter=@repo/* --filter=@api/* --filter=@lib/*",
        "test:unit": "turbo run test:unit",
        "test:unit:web": "turbo run test:unit --filter=web",
        "format:check": "bunx biome format",
        "format:fix": "bunx biome format --write",
        "format:packages": "sort-package-json \"apps/**/package.json\" \"packages/**/package.json\" \"!/**/node_modules/**/package.json\"",
        "lint:check": "bunx --bun biome lint",
        "lint:fix": "bunx --bun biome lint --write",
        "knip": "knip",
        "env:refresh-examples": "bun run scripts/refresh-env-examples.script.ts",
        "clean": "bun run clean:pm && bun run clean:node_modules && bun run clean:turbo && bun run clean:dist",
        "clean:pm": "bun pm cache rm",
        "clean:turbo": "bun x rimraf .turbo apps/**/.turbo packages/**/.turbo",
        "clean:node_modules": "bun x rimraf node_modules apps/**/node_modules packages/**/node_modules",
        "clean:dist": "bun x rimraf apps/**/dist packages/**/dist",
        "docker:up": "docker compose -f docker/infra.yaml -f docker/gateway.yaml -f docker/boards.yaml -f docker/media.yaml --env-file .env up",
        "docker:down": "docker compose -f docker/infra.yaml -f docker/gateway.yaml -f docker/boards.yaml -f docker/media.yaml down",
        "test:current": "turbo run test:unit --filter=media"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.7",
        "bun-plugin-swc": "^0.0.1",
        "knip": "^5.86.0",
        "sort-package-json": "^4.0.0",
        "turbo": "^2.8.17"
    },
    "workspaces": ["apps/*", "packages/api/*", "packages/config/*", "packages/contracts/*", "packages/lib/*"]
}
