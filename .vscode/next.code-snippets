{
    // * View Model Snippets

    "Create View Model": {
        "prefix": "v-model",
        "body": [
            "import { OmitFields } from \"@/shared/lib/typescript.lib\";",
            "import { ViewModel, ViewModelParams } from \"../../types\";",
            "import { $1ViewState } from \"./view-state\";",
            "import { $1NodesMapper } from \"./nodes-mapper.lib\";",
            "",
            "export function use$1ViewModel(params: ViewModelParams) {",
            "    const { nodesModel } = params;",
            "",
            "    return (viewState: $1ViewState): OmitFields<ViewModel, \"actions\"> => {",
            "        return {",
            "            nodes: $1NodesMapper.from(nodesModel.nodes).get(),",
            "            canvas: {},",
            "            layout: {},",
            "            overlay: {},",
            "            window: {}",
            "        };",
            "    };",
            "}"
        ]
    },
    "Create View State": {
        "prefix": "v-state",
        "body": ["export type $1ViewState = {", "    type: \"$2\";", "};"]
    },
    "Create View State Switch": {
        "prefix": "v-switcher",
        "body": [
