            "",
            "type Params = {};",
            "",
            "export function switchTo$1({}: Params): $1ViewState {",
            "    return {",
            "        type: \"$2\"",
            "    };",
            "}"
        ]
    },
    "Create Nodes Mapper": {
        "prefix": "n-mapper",
        "body": [
