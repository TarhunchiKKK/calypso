{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "ignore": ["apps/web/src/shared/ui/kit/*","apps/web/src/features/formattable-input/ui/*", "apps/web/src/dev/*", "**/mocks/**", "**/*.page.tsx"],
    "ignoreBinaries": ["protoc"],
    "ignoreDependencies": ["google-proto-files"],
    "rules": {
        "files": "error",
        "classMembers": "error",
        "types": "error",
        "dependencies": "error",
        "devDependencies": "error",
        "unlisted": "off"
    }
}
