{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "project": ["apps/**/*.ts"],
    "ignore": ["apps/web/src/shared/ui/kit/*", "apps/web/src/@types/*", "apps/web/src/dev/*"],
    "rules": {
        "files": "error",
        "classMembers": "error",
        "types": "error",
        "dependencies": "error",
        "devDependencies": "error",
        "unlisted": "off"
    }
}
