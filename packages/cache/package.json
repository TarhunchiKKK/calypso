{
    "name": "@repo/cache",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "main": "./dist/entry.js",
    "types": "./dist/entry.d.ts",
    "files": ["./dist/**"],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./dist/entry.js",
            "require": "./dist/entry.js"
        },
        "./*": {
            "import": "./dist/*.js",
            "require": "./dist/*.js"
        }
    },
    "scripts": {
        "dev": "pnpm build --watch",
        "build": "tsc -b -v",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.16",
        "@nestjs/core": "^11.1.17",
        "@nestjs/microservices": "^11.1.16",
        "express": "^5.2.1",
        "ioredis": "^5.11.1",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/node": "^22.10.7",
        "typescript": "5.5.4"
    }
}
