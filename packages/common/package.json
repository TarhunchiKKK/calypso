{
    "name": "@repo/common",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "main": "./dist/cjs/entry.js",
    "module": "./dist/esm/entry.js",
    "types": "./dist/cjs/entry.d.ts",
    "files": ["./dist/**"],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/cjs/entry.d.ts",
            "import": "./dist/esm/entry.js",
            "require": "./dist/cjs/entry.js"
        },
        "./auth": {
            "types": "./dist/cjs/auth/index.d.ts",
            "import": "./dist/esm/auth/index.js",
            "require": "./dist/cjs/auth/index.js"
        },
        "./media": {
            "types": "./dist/cjs/media/index.d.ts",
            "import": "./dist/esm/media/index.js",
            "require": "./dist/cjs/media/index.js"
        },
        "./projects": {
            "types": "./dist/cjs/projects/index.d.ts",
            "import": "./dist/esm/projects/index.js",
            "require": "./dist/cjs/projects/index.js"
        },
        "./shared": {
            "types": "./dist/cjs/shared/index.d.ts",
            "import": "./dist/esm/shared/index.js",
            "require": "./dist/cjs/shared/index.js"
        }
    },
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/node": "^22.10.7",
        "tsup": "^8.5.1",
        "typescript": "5.5.4"
    },
    "dependencies": {
        "zod": "^4.3.6"
    }
}
