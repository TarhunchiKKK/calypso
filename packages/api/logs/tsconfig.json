{
    "extends": "@config/typescript/nestjs.json",
    "compilerOptions": {
        "allowJs": true,
        "baseUrl": "src",
        "esModuleInterop": true,
        "incremental": false,
        "outDir": "dist",
        "strictNullChecks": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
