        "typescript": "5.5.4"
    },
    "peerDependencies": {
        "@api/common": "*",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/microservices": "^11.0.0",
