{
    "name": "@repo/api",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "main": "./dist/entry.js",
    "types": "./dist/entry.d.ts",
    "files": ["./dist/**"],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./dist/entry.js",
            "require": "./dist/entry.js"
        },
        "./*": {
            "import": "./dist/*.js",
            "require": "./dist/*.js"
        }
    },
    "scripts": {
        "dev": "pnpm build --watch",
        "build": "tsc -b -v",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "@nestjs/common": "^11.1.16",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.1.17",
        "@nestjs/microservices": "^11.1.16",
        "@nestjs/mongoose": "^11.0.4",
        "@nestjs/typeorm": "^11.0.0",
        "@repo/auth": "*",
        "@repo/boards": "*",
        "@repo/common": "*",
        "@repo/media": "*",
        "@repo/projects": "*",
        "rxjs": "^7.8.2",
        "typeorm": "^0.3.28",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/node": "^22.10.7",
        "ts-node": "^10.9.2",
        "typescript": "5.5.4"
    }
}
