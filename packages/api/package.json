{
    "name": "@repo/api",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "dev": "pnpm build --watch",
        "build": "tsc -b -v",
        "protoc": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/grpc/generated --proto_path=proto --proto_path=./node_modules/google-proto-files proto/*.proto --ts_proto_opt=nestJs=true --ts_proto_opt=snakeToCamel=false --ts_proto_opt=outputJsonMethods=false; bun run ./scripts/fix-protoc.ts",
        "fix": "bun run ./scripts/fix-protoc.ts"
    },
    "main": "./dist/entry.js",
    "types": "./dist/entry.d.ts",
    "files": ["./dist/**"],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "import": "./dist/entry.js",
            "require": "./dist/entry.js"
        },
        "./*": {
            "import": "./dist/*.js",
            "require": "./dist/*.js"
        }
    },
    "dependencies": {
        "@nestjs/common": "^11.1.16",
        "@nestjs/config": "^4.0.3",
        "@nestjs/mapped-types": "*",
        "@nestjs/microservices": "^11.1.16",
        "@nestjs/mongoose": "^11.0.4",
        "@nestjs/typeorm": "^11.0.0",
        "@repo/common": "*",
        "protobufjs": "^8.0.0",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@repo/eslint-config": "*",
        "@repo/typescript-config": "*",
        "@types/node": "^22.10.7",
        "google-proto-files": "^5.0.1",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.2",
        "ts-proto": "^2.11.6",
        "typescript": "5.5.4"
    }
}
