{
    "name": "@api/contracts",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "main": "./dist/entry.js",
    "types": "./dist/entry.d.ts",
    "files": ["./dist/**"],
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/entry.d.ts",
            "import": "./dist/entry.js",
            "require": "./dist/entry.js"
        }
    },
    "scripts": {
        "build": "tsc -b -v",
        "type-check": "tsc --noEmit",
        "protoc:unix": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --proto_path=proto --proto_path=./node_modules/google-proto-files proto/**/*.proto --ts_proto_opt=nestJs=true --ts_proto_opt=snakeToCamel=false --ts_proto_opt=outputJsonMethods=false --ts_proto_opt=useOptionals=none; bun run ./scripts/fix-protoc.script.ts",
        "protoc:win": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto.exe --ts_proto_out=./src/generated --proto_path=proto --proto_path=./node_modules/google-proto-files proto/**/*.proto --ts_proto_opt=nestJs=true --ts_proto_opt=snakeToCamel=false --ts_proto_opt=outputJsonMethods=false --ts_proto_opt=useOptionals=none; bun run ./scripts/fix-protoc.script.ts",
        "fix": "bun run ./scripts/fix-protoc.script.ts"
    },
    "dependencies": {
        "google-proto-files": "^5.0.1"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/node": "^22.10.7",
        "ts-proto": "^2.11.6",
        "typescript": "5.5.4",
        "@nestjs/common": "^11.1.16",
        "@nestjs/core": "^11.1.17",
        "@nestjs/microservices": "^11.1.16",
        "@lib/boards": "*",
        "@lib/common": "*",
        "rxjs": "^7.8.2"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/microservices": "^11.0.0",
        "@lib/boards": "*",
        "@lib/common": "*",
        "rxjs": "^7.8.0"
    }
}
