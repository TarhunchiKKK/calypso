{
    "extends": "@repo/typescript-config/nestjs.json",
    "compilerOptions": {
        "allowJs": true,
        "baseUrl": "src",
        "esModuleInterop": true,
        "incremental": false,
        "outDir": "dist",
        "types": ["node"],
        "strictNullChecks": true,
        "target": "ES2022"
    },
    "include": ["src"],
    "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
