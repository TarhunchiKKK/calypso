                    { "description": "Way to sort projects", "name": "sortOrder", "in": "query", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "200": { "description": "" } },
                "security": [{ "cookie": [] }],
                "status": 200,
                "summary": "",
                "tags": ["Projects"],
                "type": [null]
            }
