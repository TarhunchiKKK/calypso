            "post": {
                "description": "Project successfully duplicated",
                "operationId": "ProjectsController_duplicate",
                "parameters": [
                    { "description": "Project unique id", "name": "id", "in": "query", "required": true, "schema": { "format": "uuid", "type": "string" } },
                    { "description": "Project type", "name": "type", "in": "query", "required": true, "schema": { "type": "string" } },
                    { "description": "Project title", "name": "title", "in": "query", "required": true, "schema": { "type": "string" } }
                ],
                "responses": { "201": { "description": "" } },
                "security": [{ "cookie": [] }],
                "status": 201,
                "summary": "",
                "tags": ["Projects"]
            }
        },
        "/projects/all": {
            "get": {
                "description": "Projects successfully retrieved",
                "isArray": true,
                "operationId": "ProjectsController_findAll",
                "parameters": [
                    {
                        "description": "Page to select",
                        "name": "page",
                        "in": "query",
                        "required": true,
                        "schema": { "minimum": 0, "format": "int32", "type": "number" }
                    },
                    {
                        "description": "Count to select",
                        "name": "count",
                        "in": "query",
                        "required": true,
                        "schema": { "minimum": 1, "format": "int32", "type": "number" }
                    },
                    {
                        "description": "Type to filter projects",
                        "name": "type",
                        "in": "query",
                        "required": true,
                        "schema": { "nullable": true, "type": "string" }
                    },
                    {
                        "description": "Defines who is the creator of the project",
                        "name": "own",
                        "in": "query",
                        "required": true,
                        "schema": { "nullable": true, "type": "boolean" }
