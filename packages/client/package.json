{
    "name": "@contracts/http",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "exports": {
        ".": {
            "types": "./dist/entry.d.ts",
            "import": "./dist/entry.js",
            "require": "./dist/entry.js"
        }
    },
    "main": "./dist/entry.js",
    "types": "./dist/entry.d.ts",
    "files": ["./dist/**"],
    "scripts": {
        "build": "tsc -b -v",
        "generate:json": "openapi-typescript ./swagger/swagger.json -o ./src/generated.ts",
        "generate:yaml": "openapi-typescript ./swagger/swagger.yaml -o ./src/generated.ts",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "@repo/typescript-config": "*",
        "@types/node": "^22.10.7",
        "openapi-typescript": "^7.13.0",
        "rxjs": "^7.8.2",
        "typescript": "5.5.4"
    },
    "peerDependencies": {
        "rxjs": "^7.8.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "openapi-fetch": "^0.17.0"
    }
}
