{
    "name": "@lib/boards",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/entry.d.ts",
                "default": "./dist/esm/entry.js"
            },
            "require": {
                "types": "./dist/cjs/entry.d.ts",
                "default": "./dist/cjs/entry.js"
            }
        }
    },
    "main": "./dist/cjs/entry.js",
    "module": "./dist/esm/entry.js",
    "types": "./dist/cjs/entry.d.ts",
    "files": [
        "./dist/**"
    ],
    "scripts": {
        "build": "tsup --config tsup.config.ts",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "@lib/common": "*",
        "@lib/projects": "*",
        "@repo/typescript-config": "*",
        "@types/node": "^22.10.7",
        "tsup": "^8.5.1",
        "typescript": "5.5.4",
        "zod": "^4.3.6"
    },
    "peerDependencies": {
        "zod": "^4.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
